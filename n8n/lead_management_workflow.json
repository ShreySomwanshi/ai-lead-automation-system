          }
        ],
        [
          {
            "node": "Handle Invalid Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Ingest & Duplicate Check API": {
      "main": [
        [
          {
            "node": "Is Duplicate Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Duplicate Lead?": {
      "main": [
        [
          {
            "node": "Handle Duplicate Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "4. Ollama Lead Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Ollama Lead Analysis": {
      "main": [
        [
          {
            "node": "5. Hermes Agent Tool Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "5. Hermes Agent Tool Workflow": {
      "main": [
        [
          {
            "node": "6. Save Status & Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "6. Save Status & Audit Log": {
      "main": [
        [
          {
            "node": "7. Generate Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
